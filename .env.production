# Production Environment Configuration
FLUTTER_ENV=production

# API Configuration
API_BASE_URL=https://api-usago.ajianaz.dev
API_VERSION=v1
API_TIMEOUT=30000

# API Headers
CONTENT_TYPE_HEADER=application/json
ACCEPT_HEADER=application/json
BEARER_TOKEN_HEADER=Authorization

# Response Codes
SUCCESS_CODE=200
UNAUTHORIZED_CODE=401
FORBIDDEN_CODE=403
NOT_FOUND_CODE=404
SERVER_ERROR_CODE=500

# Feature Flags
ENABLE_LOGGING=false
ENABLE_CRASH_REPORTING=true
ENABLE_ANALYTICS=true

# Security
ENCRYPTION_KEY=production_encryption_key_must_be_secure
JWT_SECRET=production_jwt_secret_must_be_secure

# External Services
SENTRY_DSN=https://your-sentry-dsn-production@sentry.io/project-id
FIREBASE_API_KEY=production_firebase_api_key_here

# Debug Settings
DEBUG_MODE=false
LOG_LEVEL=error