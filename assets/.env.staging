# Staging Environment Configuration
FLUTTER_ENV=staging

# API Configuration
API_BASE_URL=https://staging-api-usago.ajianaz.dev
API_VERSION=v1
API_TIMEOUT=30000

# API Headers
CONTENT_TYPE_HEADER=application/json
ACCEPT_HEADER=application/json
BEARER_TOKEN_HEADER=Authorization

# Response Codes
SUCCESS_CODE=200
UNAUTHORIZED_CODE=401
FORBIDDEN_CODE=403
NOT_FOUND_CODE=404
SERVER_ERROR_CODE=500

# Feature Flags
ENABLE_LOGGING=true
ENABLE_CRASH_REPORTING=true
ENABLE_ANALYTICS=true

# Security
ENCRYPTION_KEY=staging_encryption_key_change_in_production
JWT_SECRET=staging_jwt_secret_change_in_production
ENCRYPTION_ALGORITHM=AES-256-GCM
KEY_CIPHER_ALGORITHM=AES-256-CBC
STORAGE_CIPHER_ALGORITHM=AES-128-GCM

# External Services
SENTRY_DSN=https://your-sentry-dsn-staging@sentry.io/project-id
FIREBASE_API_KEY=staging_firebase_api_key_here

# Debug Settings
DEBUG_MODE=true
LOG_LEVEL=info